# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO vai para o Git (está no .gitignore); este modelo vai.

# Porta da API
PORT=3000

# postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financas

# Segredo usado para assinar os tokens JWT. Use um texto longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Validade do token (formato do jsonwebtoken: 15m, 1h, 1d...)
JWT_EXPIRES_IN=1h

# Origem do front-end autorizada pelo CORS (separe várias com vírgula)
CORS_ORIGIN=http://localhost:5173
